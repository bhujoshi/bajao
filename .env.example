# Database (SQLite locally or PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Server session & OTP HMAC secret
SESSION_SECRET="replace_with_a_strong_32_byte_random_secret_in_production"

# Optional: Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Optional: Email & SMS OTP Providers
RESEND_API_KEY=""
EMAIL_FROM="Wedding Memories <noreply@yourdomain.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Meta WhatsApp Cloud API — server-only, never NEXT_PUBLIC_ variables
# Use the Phone Number ID, not the sender's displayed phone number.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v25.0"
WHATSAPP_INVITATION_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
# Comma-separated Memorica user IDs authorized to use this business sender.
WHATSAPP_HOST_USER_IDS=""
# Reachable HTTPS deployment URL: localhost links cannot be opened by guests.
MEMORICA_PUBLIC_URL=""
